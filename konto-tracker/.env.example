# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env ist per .gitignore ausgeschlossen und darf NIE committet werden.

# Enable Banking (https://enablebanking.com → Control Panel → Applications)
EB_APPLICATION_ID=deine-application-id
EB_PRIVATE_KEY_PATH=./secrets/private.pem

# Muss exakt einer der in der Enable-Banking-App registrierten Redirect-URLs entsprechen
EB_REDIRECT_URL=https://localhost/callback

# Optional (Defaults in Klammern)
# EB_API_ORIGIN=https://api.enablebanking.com
# EB_CONSENT_DAYS=90          # Gültigkeit des Bank-Consents (max. 90 bei PSD2 üblich)
# KONTO_DB_PATH=./data/kontotracker.db
# KONTO_FIRST_FETCH_DAYS=730  # Historie beim allerersten Abruf (bis zu 24 Monate)
